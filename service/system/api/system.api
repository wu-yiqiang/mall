syntax = "v1"

info (
	title:   "mall"
	desc:    "系统服务"
	author:  "Sutter"
	email:   "sutter.wu@outlook.com"
	version: "1.0"
	schemes: http
)

type loginRequest {
	UserName string `json:"username,default=Sutter"`
	Password string `json:"password,default=1234@Abcd"`
}

type Role {
	RoleId string `json:"roleId"`
	Name   string `json:"name"`
	Code   string `json:"code"`
}

type Menu {
	MenuId   string `json:"menuId"`
	Name     string `json:"name"`
	Code     string `json:"code"`
	Path     string `json:"path"`
	Serial   string `json:"serial"`
	ParentId string `json:"parentId"`
}

type Button {
	ButtonId string `json:"buttonId"`
	Name     string `json:"name"`
	Code     string `json:"code"`
}

type loginResponse {
	Message      string      `json:"message"`
	AccessToken  string      `json:"accessToken"`
	AccessExpire int         `json:"accessExpire"`
	RefreshAfter int         `json:"refreshAfter"`
	Roles        []Role      `json:"roles"`
	Menus        []Menu      `json:"menus"`
	Buttons      []Button    `json:"buttons"`
	UserDetails  UserDetails `json:"userDetails"`
}

type UserDetails {
	UserID   string `json:"userId"`
	UserName string `json:"username"`
	Email    string `json:"email"`
	Gender   int64  `json:"gender"`
}

type registerRequest {
	UserName string `json:"username"`
	Password string `json:"password"`
}

type registerResponse {
	Message string `json:"message"`
}

type roleSearchRequest {
	Keyword string `json:"keyword"`
}

type roleSearchResponse {
	Message string `json:"message"`
}

type (
	userDetailsRequest {
		UserId string `json:"user_id"`
	}
)

type (
	userDetailsResponse {
		Message string      `json:"message"`
		Data    interface{} `json:"data"`
	}
)

@server (
	prefix:  api
	tags:    "用户管理"
	summary: "用户管理接口"
)
service system-api {
	@doc (
		description: "用户登录"
	)
	@handler UserLoginHandle
	post /system/user/login (loginRequest) returns (loginResponse)

	@doc (
		description: "用户详情"
	)
	@handler UserDetailsHandle
	post /system/user/details (userDetailsRequest) returns (userDetailsResponse)

	@doc (
		description: "用户注册"
	)
	@handler UserRegisterHandle
	post /system/user/register (registerRequest) returns (registerResponse)

	@handler RoleHandle
	post /system/role/search (roleSearchRequest) returns (roleSearchResponse)
}

